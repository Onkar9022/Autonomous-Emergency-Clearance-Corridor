# AECC Backend Environment Configuration — Example Template
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL Database Connection Strings
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="replace-with-a-secure-random-secret"
JWT_EXPIRES_IN="7d"
