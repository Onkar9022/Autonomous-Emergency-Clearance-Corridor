# Autonomous Emergency Corridor Creator System (AECC) — Environment Configuration
# Team Sanjivani

# Application Port & Mode
VITE_APP_MODE=SIMULATION
VITE_DEFAULT_REGION="Solapur, Maharashtra, India"
VITE_API_BASE_URL=http://localhost:5000/api

# Routing Engine (OSRM Public API / Local Docker Instance)
# Default public endpoint works out-of-the-box without API keys:
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org

# Map Tile Provider (CartoDB Voyager raster tiles)
VITE_CARTO_API_KEY=your_carto_api_key_here
VITE_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=your_carto_api_key_here

# Optional Firebase Configuration (for live cloud persistence & auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=aecc-sanjivani.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aecc-sanjivani-ops
VITE_FIREBASE_STORAGE_BUCKET=aecc-sanjivani.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional ESP32 / NTCIP Hardware Gateway Configuration
VITE_HARDWARE_GATEWAY_IP=192.168.4.1
VITE_HARDWARE_GATEWAY_PORT=8080
VITE_HARDWARE_AUTH_TOKEN=your_secure_device_token_here
